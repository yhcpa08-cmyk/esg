<IfModule mod_rewrite.c>
    RewriteEngine On
    # 專案根目錄同時含程式、資料庫腳本與附件；禁止直接由 Web 讀取。
    RewriteRule ^(?:app|config|database|storage)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:test_system|comprehensive_role_test|extracted_spec)\.php$ - [F,L,NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php [L,QSA]
</IfModule>

<FilesMatch "^(?:\.env|\.ht|.*\.(?:sql|log|bak|sh))$">
    Require all denied
</FilesMatch>
